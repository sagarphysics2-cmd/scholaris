# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by the application and Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/scholaris"
# Separate database used by the integration test-suite (it is wiped by tests!).
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/scholaris_test"

# ─── Application ─────────────────────────────────────────────────────────────
# Public base URL (used in emails: invitations, password resets).
APP_URL="http://localhost:3000"
# Session lifetime in days (sliding expiration).
SESSION_TTL_DAYS=7

# ─── File storage ────────────────────────────────────────────────────────────
# "local" stores files on disk under STORAGE_LOCAL_DIR (development / single VM).
# "s3" uses any S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, ...).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Maximum upload size in megabytes.
MAX_UPLOAD_MB=10

# ─── Email ───────────────────────────────────────────────────────────────────
# "console" prints emails to the server log (development). "smtp" sends real email.
MAIL_DRIVER="console"
MAIL_FROM="Scholaris <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE=false

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Shared secret for /api/cron/* (fee-reminders, assignment-reminders, publish-notices, cleanup).
# Generate with: openssl rand -hex 32. Leave empty to disable the endpoints.
CRON_SECRET=""

# ─── Seed (development only) ─────────────────────────────────────────────────
# Password given to every demo account created by `npm run db:seed`.
SEED_DEMO_PASSWORD="ChangeMe!2026"
